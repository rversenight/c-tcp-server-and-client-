#ifndef OUCH_CLIENT_H
#define OUCH_CLIENT_H

#include <iostream>
#include <cstring>
#include <algorithm>
#include <cstdint>
#include <chrono>
#include <sys/socket.h>
#include <arpa/inet.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/select.h>

#include "Config.h"
#include "Logger.h"

#pragma pack(push, 1)
struct BistechOuchLogon {
    char messageType;       // 'L'
    char username[6];
    char password[10];
    char activeSession[10];
};

struct BistechOuchEnterOrder {
    char     messageType;       // 'O'
    char     orderToken[14];
    uint32_t orderBookID;
    char     side;
    uint64_t quantity;
    uint32_t price;
    uint8_t  timeInForce;
    uint8_t  openClose;
    char     clientAccount[16];
    char     customerInfo[15];
    char     exchangeInfo[32];
    uint64_t displayQuantity;
    uint8_t  clientCategory;
    uint8_t  offHours;
    uint8_t  smpLevel;
    uint8_t  smpMethod;
    char     smpID[3];
    char     reserved[2];
};

struct BistechOuchCancelOrder {
    char     messageType;       // 'C'
    char     orderToken[14];
    uint64_t quantity;
};

struct BistechOuchReplaceOrder {
    char     messageType;       // 'U'
    char     existingToken[14];
    char     replacementToken[14];
    uint64_t quantity;
    uint32_t price;
    uint8_t  timeInForce;
    uint64_t displayQuantity;
};

struct BistechOuchHeartbeat {
    char messageType;       // 'R'
};
#pragma pack(pop)

class OuchClient {
private:
    int sock = -1;
    OuchConfig config;
    std::chrono::steady_clock::time_point last_send_time;
    
    // RTT Takibi için değişkenler
    std::chrono::high_resolution_clock::time_point last_order_sent_time;
    bool waiting_for_ack = false;

    void update_last_send_time() {
        last_send_time = std::chrono::steady_clock::now();
    }

public:
    OuchClient(const OuchConfig& cfg) : config(cfg) {
        update_last_send_time();
    }
    ~OuchClient() { disconnect(); }

    bool connect_server() {
        sock = socket(AF_INET, SOCK_STREAM, 0);
        if (sock < 0) return false;

        int flags = fcntl(sock, F_GETFL, 0);
        fcntl(sock, F_SETFL, flags | O_NONBLOCK);

        sockaddr_in server_addr{};
        server_addr.sin_family = AF_INET;
        server_addr.sin_port = htons(config.port);

        if (inet_pton(AF_INET, config.ip.c_str(), &server_addr.sin_addr) <= 0) {
            close(sock);
            sock = -1;
            return false;
        }

        Logger::log("AG", "Baglaniliyor: " + config.ip + ":" + std::to_string(config.port));
        
        int res = connect(sock, (struct sockaddr*)&server_addr, sizeof(server_addr));
        if (res < 0 && errno == EINPROGRESS) {
            fd_set myset;
            struct timeval tv{3, 0};
            FD_ZERO(&myset);
            FD_SET(sock, &myset);
            
            if (select(sock + 1, NULL, &myset, NULL, &tv) <= 0) {
                Logger::log("HATA", "Baglanti zaman asimina ugradi!");
                close(sock);
                sock = -1;
                return false;
            }
        }

        Logger::log("OK", "Baglanti kuruldu.");
        update_last_send_time();
        return true;
    }

    bool send_logon() {
        if (sock < 0) return false;

        BistechOuchLogon logon{};
        logon.messageType = 'L';
        std::memcpy(logon.username, config.username.c_str(), std::min((size_t)6, config.username.length()));
        std::memcpy(logon.password, config.pass.c_str(), std::min((size_t)10, config.pass.length()));

        ssize_t sent = send(sock, &logon, sizeof(logon), 0);
        if (sent > 0) {
            Logger::log("LOGON", "Giris paketi gonderildi.");
            update_last_send_time();
            return true;
        }
        return false;
    }

    bool send_order(const std::string& hisse, double fiyat, uint64_t lot) {
        if (sock < 0) return false;

        BistechOuchEnterOrder emir{};
        emir.messageType = 'O';
        std::string token = "ORD" + hisse + "001";
        std::memcpy(emir.orderToken, token.c_str(), std::min((size_t)14, token.length()));
        emir.orderBookID = (hisse == "THYAO") ? 1045 : 2088;
        emir.side = 'B';
        emir.quantity = lot;
        emir.price = static_cast<uint32_t>(fiyat * 100);
        emir.clientCategory = static_cast<uint8_t>(config.client_category);
        std::memcpy(emir.clientAccount, config.account_number.c_str(), std::min((size_t)16, config.account_number.length()));

        // Emir gönderilmeden hemen önce kronometreyi başlat
        last_order_sent_time = std::chrono::high_resolution_clock::now();
        waiting_for_ack = true;

        ssize_t sent = send(sock, &emir, sizeof(emir), 0);
        if (sent > 0) {
            Logger::log("EMIR", "Yeni emir gonderildi -> " + hisse + " | " + std::to_string(lot) + " Lot");
            update_last_send_time();
            return true;
        }
        return false;
    }

    void check_heartbeat(int interval_seconds = 15) {
        if (sock < 0) return;

        auto now = std::chrono::steady_clock::now();
        auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(now - last_send_time).count();

        if (elapsed >= interval_seconds) {
            BistechOuchHeartbeat hb{};
            hb.messageType = 'R';

            ssize_t sent = send(sock, &hb, sizeof(hb), 0);
            if (sent > 0) {
                Logger::log("HEARTBEAT", "Kalp atisi paketi atildi (Hatti sicak tutma).");
                update_last_send_time();
            }
        }
    }

    void process_incoming_data() {
        if (sock < 0) return;

        char buffer[1024];
        ssize_t bytes_received = recv(sock, buffer, sizeof(buffer), 0);

        if (bytes_received > 0) {
            char msgType = buffer[0];
            
            // Yanıt geldiği an yüksek hassasiyetli saati al
            auto recv_time = std::chrono::high_resolution_clock::now();

            Logger::log("RECV", "Veri geldi. Tip: " + std::string(1, msgType));

            switch (msgType) {
                case 'A': {
                    Logger::log("INFO", " -> Emir onaylandi.");
                    if (waiting_for_ack) {
                        auto rtt_us = std::chrono::duration_cast<std::chrono::microseconds>(recv_time - last_order_sent_time).count();
                        Logger::log("PERF", "Round-Trip Latency (RTT) [ONAY]: " + std::to_string(rtt_us) + " us");
                        waiting_for_ack = false;
                    }
                    break;
                }
                case 'J': {
                    Logger::log("INFO", " -> Emir reddedildi!");
                    if (waiting_for_ack) {
                        auto rtt_us = std::chrono::duration_cast<std::chrono::microseconds>(recv_time - last_order_sent_time).count();
                        Logger::log("PERF", "Round-Trip Latency (RTT) [RED]: " + std::to_string(rtt_us) + " us");
                        waiting_for_ack = false;
                    }
                    break;
                }
                case 'K':
                    Logger::log("INFO", " -> Giris basarili.");
                    break;
                default:
                    break;
            }
        } else if (bytes_received == 0) {
            Logger::log("AG", "Baglanti kapandi.");
        } else {
            if (errno != EWOULDBLOCK && errno != EAGAIN) {
                Logger::log("HATA", "Okuma hatasi!");
            }
        }
    }

    void disconnect() {
        if (sock >= 0) {
            close(sock);
            sock = -1;
            Logger::log("AG", "Baglanti kapatildi.");
        }
    }
};

#endif
