#include <iostream>
#include "Config.h"
#include "OuchClient.h"

int main() {
    OuchConfig config;
    if (!ConfigLoader::load("setting.json", config)) {
        std::cerr << "[HATA] setting.json okunamadi!" << std::endl;
        return -1;
    }

    std::cout << "=================================================" << std::endl;
    std::cout << " BISTECH OUCH Client (Modular OOP Architecture)" << std::endl;
    std::cout << "=================================================\n" << std::endl;

    OuchClient client(config);
    
    if (client.connect_server()) {
        client.send_logon();
        client.send_order("THYAO", 312.50, 10);
    }

    return 0;
}
