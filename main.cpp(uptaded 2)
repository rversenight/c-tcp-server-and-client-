// --- CONFIG STRUCT ---
struct OuchConfig {
    bool enabled = false;
    std::string desc;
    std::string client_account;
    std::string account_number;
    std::string username;
    std::string pass;
    std::string ip;
    int port = 0;
    int client_category = 1;
};

// --- BISTECH 114 BYTE ENTER ORDER PACKET ---
#pragma pack(push, 1)
struct BistechOuchEnterOrder {
    char     messageType;       // 1 Byte ('O')
